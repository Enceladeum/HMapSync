<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Version>1.0.1.5</Version>
        <AssemblyName>HMSync</AssemblyName>
        <RootNamespace>HMSync</RootNamespace>
        <Nullable>enable</Nullable>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <!-- Optional local build overlay: if an HMSync.testing.props file is present next to this project
         it is imported, otherwise this Import is an inert no-op. A standard checkout does not include
         that file, so it has no effect on the normal build. -->
    <Import Project="$(MSBuildProjectDirectory)\HMSync.testing.props"
            Condition="Exists('$(MSBuildProjectDirectory)\HMSync.testing.props')" />

    <ItemGroup>
        <!-- S327: named opcode→id map (FFXIVOpcodes, Global region). Embedded so the packet inspector can label
             packets by name (e.g. 356 → ActorControlSelf). Opcodes rotate per patch; swap this JSON to update.
             The NAME is the durable identity we care about - numbers are per-version. -->
        <EmbeddedResource Include="opcodes.min.json" />
        <!-- NB-33: derived venue(stagedir)→quest map for auto-detected cutscene-only venues. DERIVED artifact, not
             hand-authored (Fable's cutscene-territory-index.csv joined with dominant-venue-per-cutb from scene-parts).
             CutsceneStageDetectService reads it to label detected venues. Regenerate per patch (like opcodes.min.json);
             a stale map just means new venues show no quest until refreshed. -->
        <EmbeddedResource Include="cutscene-quests.json" />
        <!-- NB-33: derived venue(stagedir)→spawn map for auto-detected cutscene-only venues. DERIVED artifact, not
             hand-authored: median-floor centroid of each venue's cutb character keyframes (same provenance the curated
             AllStages spawns came from). A venue absent here keeps its donor-territory fallback spawn (no regression).
             Regenerate per patch. -->
        <EmbeddedResource Include="cutscene-spawns.json" />
        <!-- DEBRIS: TerritoryId-keyed op=None battle-debris hide set for Tuliyollal (y6t1, TT 1185). Its
             MSQ-invasion debris is a single always-on (FilterOp=None) SharedGroup instance (y6t1_destory =
             InstanceId 10757216, asset sgbg_y6t1_w1_des01.sgb) that the server hides by LayerId once the quest
             clears. A serverless HMS load can't receive that toggle, so the debris shows; hiding that one SGB
             (ApplyIdSet cascades to its children) restores the peaceful city. One InstanceKey per line;
             compiled offline from xivtool lgb 1185. -->
        <EmbeddedResource Include="y6t1.debris-hide.txt" />
        <!-- DEBRIS: Solution Nine (x6t1, TT 1186) invasion-aftermath debris hide. The post-battle overworld
             draws one aftermath SharedGroup (x6t1_battle_zoneshared, InstanceId 10399297, asset
             sgbg_x6t1_q1_qic00.sgb) that the server toggles off by LayerId once the cleanup quest clears; a
             serverless HMS load never gets that. Hide the SGB (ApplyIdSet cascades to children) for a peaceful
             Solution Nine. One InstanceKey per line; compiled offline from xivtool lgb 1186. -->
        <EmbeddedResource Include="x6t1.debris-hide.txt" />
        <!-- WEATHER: shipped baked EnvState presets (weather id -> base64 of a 0x2F8 EnvState snapshot captured
             under that weather on a donor zone). Embedding makes them sync-deterministic: every peer decodes
             byte-identical blobs, so a host's crammed sky reproduces exactly on all clients. Regenerate per
             patch only if the EnvState layout shifts. -->
        <EmbeddedResource Include="weather-presets.json" />
        <!-- WEATHER: the shipped day-night keyframe library backing the per-city day/night "City sky variants"
             feature. Byte-identical for every peer so a fresh install's picker is fully populated and a future
             graft-sync only needs to send (weather, donor). -->
        <EmbeddedResource Include="keyframe-sets.json" />
    </ItemGroup>

    <ItemGroup>
        <!--
          S246: Glamourer.Api - the official consumer IPC package (Glamourer.Api.IpcSubscribers.*,
          Glamourer.Api.Enums.*). Used to drive cosmetic visibility toggles (hat/visor/weapon/ears)
          through Glamourer when it's installed. The 2.x line is current; NuGet resolves the latest.
          Glamourer.Api.dll MUST ship next to HMSync.dll — a plain PackageReference copies it to
          output, which is correct. Do NOT add AssemblyLoadContext: IPC crosses the ALC boundary as
          primitives (enum values are ints on the wire), so HMS's copy never conflicts with the copy
          Glamourer itself loaded. Every Glamourer/Penumbra consumer ships the shim this way.
        -->
        <PackageReference Include="Glamourer.Api" Version="2.*" />
        <PackageReference Include="MessagePack" Version="2.5.*" /><!-- S331: v4 binary wire (Stage 4) -->
    </ItemGroup>
</Project>
